from ecdsa import NIST256p, SigningKeyfrom Crypto.Util.number import *sig = [(5832921593739954772384341732387581797486339670895875430934592373351528180781, 78576287416983546819312440403592484606132915965726128924031253623117138586396, 108582979377193966287732302562639670357586761346333866965382465209612237330851),(85517239535736342992982496475440962888226294744294285419613128065975843025446, 60425040031360920373082268221766168683222476464343035165195057634060216692194, 27924509924269609509672965613674355269361001011362007412205784446375567959036),(90905761421138489726836357279787648991884324454425734512085180879013704399530, 75779605492148881737630918749717271960050893072832415117470852442721700807111, 72740499400319841565890543635298470075267336863033867770902108413176557795256),(103266614372002123398101167242562044737358751274736728792365384600377408313142, 89519601474973769723244654516140957004170211982048028366151899055366457476708, 23639647021855356876198750083669161995553646511611903128486429649329358343588),(9903460667647154866199928325987868915846235162578615698288214703794150057571, 17829304522948160053211214227664982869100868125268116260967204562276608388692, 74400189461172040580877095515356365992183768921088660926738652857846750009205),(54539896686295066164943194401294833445622227965487949234393615233511802974126, 66428683990399093855578572760918582937085121375887639383221629490465838706027, 25418035697368269779911580792368595733749376383350120613502399678197333473802)]h = [sig[i][0] for i in range(len(sig))]r = [sig[i][1] for i in range(len(sig))]s = [sig[i][2] for i in range(len(sig))]curve = NIST256pprint(curve)n = curve.orderg = curve.generatorprint(f&#x27;n = &#123;n&#125;&#x27;)PR.&lt;x,k,a,b,c&gt; = PolynomialRing(Zmod(n))eqs = []for i in range(6):    eq = ((h[i] + x * r[i])) - s[i]*k    k = (a * k**2 + b * k + c)    eqs.append(eq)    I = PR.ideal(eqs)G = I.groebner_basis()print(G)x = -int(G[0].coefficients()[1])%nprint(f&quot;L3HCTF&#123;&#123;&#123;x&#125;&#125;&#125;&quot;)
math_problem
题面：
import gmpy2from gmpy2 import *from Crypto.Util.number import *from random import randintfrom gmpy2 import invertfrom scret import flag0def myfunction(num):    output = 0    output=num**3    return outputif __name__ == &#x27;__main__&#x27;:    flag_len = len(flag)    p, q = getPrime(512), getPrime(512)    while True:        r = getPrime(512)        R = bytes_to_long(str(r).encode())        if isPrime(R):            break    n = p * q * r    hint1 = R * r    mod = myfunction(n)    hint2 = pow(3*n+1, p % (2 ** 400), mod)    m = bytes_to_long(flag)    c = pow(m, 65537, n)    print(&#x27;All data:&#x27;)    print(f&#x27;n = &#123;n&#125;&#x27;)    print(f&#x27;c = &#123;c&#125;&#x27;)    print(f&#x27;hint1 = &#123;hint1&#125;&#x27;)    print(f&#x27;hint2 = &#123;hint2&#125;&#x27;)&#x27;&#x27;&#x27;All data:n =  =  =  = &#x27;&#x27;&#x27;
分析：
题目里给定了
hint1=R∗rhint_1=R*r\\
hint1​=R∗r
hint2=(3n+1)pl  mod  n3hint_2=(3n+1)^{p_l}\ \ mod\ \ n^3\\
hint2​=(3n+1)pl​  mod  n3
n=p∗q∗rn=p*q*r
n=p∗q∗r
所以可以通过求最大公因数的方式得到r
r=GCD(hint1,n)r=GCD(hint_1,n)
r=GCD(hint1​,n)
然后对于hint2，进一步二项展开：
hint2=(3n+1)pl  mod  n3=Cpl2(3n)2+Cpl1(3n)+1hint_2=(3n+1)^{p_l}\ \ mod\ \ n^3=C_{p_l}^2(3n)^2+C_{p_l}^1(3n)+1\\
hint2​=(3n+1)pl​  mod  n3=Cpl​2​(3n)2+Cpl​1​(3n)+1
pl=(hint2−1)//(3n)%np_l=(hint_2-1)//(3n)\%n
pl​=(hint2​−1)//(3n)%n
然后coppersmith得到p
题解：
from Crypto.Util.number import *n =  =  =  =  = 65537&#x27;&#x27;&#x27;p = getPrime(5)print(p)PR.&lt;n&gt; = PolynomialRing(ZZ)f = (3*n+1)**p % n**3print(f)# 4185*n^2 + 93*n + 1&#x27;&#x27;&#x27;r = GCD(n,hint1)pl = (hint2-1)//(3*n)%nprint(pl.bit_length())# 400n = n//rPR.&lt;x&gt; = PolynomialRing(Zmod(n))f = x*2**400 + plph = f.monic().small_roots(X=2^114,beta=0.49)p = int(ph[0])*2**400 + plprint(isPrime(p))# Trueq = n//pphi = (p-1)*(q-1)*(r-1)d = inverse(e,phi)m = pow(c,d,p*q*r)print(long_to_bytes(m))# b&#x27;L3HCTF&#123;1s_4h1s_r3a11y_m4th?&#125;&#x27;
RRRSSSAAA
题面：
from sage.all import *from secret import flagdef generate_vulnerable_key(bits=1024):    p_bits = bits // 2    q_bits = bits - p_bits    while True:        p = random_prime(2**(p_bits), lbound=2**(p_bits-1))        q = random_prime(2**(q_bits), lbound=2**(q_bits-1))        if p != q and p &gt; q and p &lt; 2*q:            break                N = p * q    phi = (p**4 - 1) * (q**4 - 1)    d_bits = 1024    d_bound = 2**d_bits    while True:        d_small = randint(2, d_bound)        d = phi - d_small        if gcd(d, phi) == 1:            if d_small.bit_length() == 1021:                break    e = inverse_mod(d, phi)        return N, edef encrypt(m, N, e):    n = 4    r = 2    R = Integers(N)    P = PolynomialRing(R, &#x27;t&#x27;)    t = P.gen()    Q = P.quotient(t**n - r)    m_poly = Q([m, 0, 0, 0])    c_poly = m_poly ** e    return c_poly.lift()if __name__ == &quot;__main__&quot;:    N, e = generate_vulnerable_key()    m = int.from_bytes(flag, &#x27;big&#x27;)    c = encrypt(m, N, e)    print(f&quot;N = &#123;N&#125;&quot;)    print(f&quot;e = &#123;e&#125;&quot;)    print(f&quot;c = &#123;c&#125;&quot;)# N = # e = # c = 
分析：
对于给定的
phi=(p4−1)(q4−1)≈N4phi=(p^4-1)(q^4-1)\approx N^4
phi=(p4−1)(q4−1)≈N4
则
ed=e(ϕ−dsmall)=1  mod  ϕedsmall=−1  mod  ϕedsmall+1=kϕed=e(\phi-d_{small})=1\ \ mod\ \ \phi\\
ed_{small}=-1\ \ mod\ \ \phi\\
ed_{small}+1=k\phi
ed=e(ϕ−dsmall​)=1  mod  ϕedsmall​=−1  mod  ϕedsmall​+1=kϕ
然后检查一下是否满足Legendre's theorem
∣eN4−kdsmall∣=∣kϕ−edsmall−kN4+kN4N4dsmall∣≈∣k(ϕ−N4)N4dsmall∣|\frac{e}{N^4}-\frac{k}{d_{small}}|=|\frac{k\phi-ed_{small}-kN^4+kN^4}{N^4d_{small}}|\approx|\frac{k(\phi-N^4)}{N^4d_{small}}|
∣N4e​−dsmall​k​∣=∣N4dsmall​kϕ−edsmall​−kN4+kN4​∣≈∣N4dsmall​k(ϕ−N4)​∣
其中
∣ϕ−N4∣=∣(p4−1)(q4−1)−p4q4∣≤p4+q4≈2∗(2512)4=22049k≈edsmallN4≈21021|\phi-N^4|=|(p^4-1)(q^4-1)-p^4q^4|\leq p^4+q^4\approx 2*(2^{512})^4=2^{2049}\\
k\approx \frac{ed_{small}}{N^4}\approx 2^{1021}
∣ϕ−N4∣=∣(p4−1)(q4−1)−p4q4∣≤p4+q4≈2∗(2512)4=22049k≈N4edsmall​​≈21021
则有
∣eN4−kdsmall∣≤21021∗22049N4dsmall≈2307024096∗21020=2−2046&lt;12dsmall2≈2−2043|\frac{e}{N^4}-\frac{k}{d_{small}}|\leq \frac{2^{1021}*2^{2049}}{N^4d_{small}}\approx \frac{2^{3070}}{2^{4096} * 2^{1020}}=2^{-2046}&lt;\frac{1}{2d_{small}^2}\approx 2^{-2043}
∣N4e​−dsmall​k​∣≤N4dsmall​21021∗22049​≈24096∗2102023070​=2−2046&lt;2dsmall2​1​≈2−2043
说明满足Legendre's theorem，所以可以通过连分数展开得到dsmalld_{small}dsmall​
然后来看加密部分：
def encrypt(m, N, e):    n = 4    r = 2    R = Integers(N)    P = PolynomialRing(R, &#x27;t&#x27;)    t = P.gen()    Q = P.quotient(t**n - r)    m_poly = Q([m, 0, 0, 0])    c_poly = m_poly ** e    return c_poly.lift()


R = Integers(N)：定义模N的整数环Z/NZ\Z /N\ZZ/NZ


P = PolynomialRing(R, 't')：在环R上构造多项式环(Z/NZ\Z/N\ZZ/NZ)[t]


Q = P.quotient(t**n - r)：构造商环Q=(Z/NZ)[t](t4−2)Q=\frac{(\Z/N\Z)[t]}{(t^4-2)}Q=(t4−2)(Z/NZ)[t]​

在Q中满足 t4=2t^4=2t4=2 (因为模掉了理想 ⟨t4−2⟩⟨t^4−2⟩⟨t4−2⟩)



m_poly = Q([m, 0, 0, 0])：将m嵌入商环Q中的元素：
mpoly=m+0∗t+0∗t2+0∗t3m_{poly}=m+0*t+0*t^2+0*t^3
mpoly​=m+0∗t+0∗t2+0∗t3

这本质上是常数多项式（仅常数项非零）



c_poly = m_poly ** e：

在商环Q中进行指数运算，但由于mpolym_{poly}mpoly​是常数多项式，运算简化为cpoly=me（在商环Q中）c_{poly}=m^e（在商环Q中）cpoly​=me（在商环Q中）
所以等价于RSA的c=me  mod  nc=m^e\ \ mod\ \ nc=me  mod  n



此处edsmall=−1  mod  ϕed_{small}=-1\ \ mod\ \ \phiedsmall​=−1  mod  ϕ，所以解密时m=c−dsmall  mod  nm=c^{-d_{small}}\ \ mod\ \ nm=c−dsmall​  mod  n
题解：
from Crypto.Util.number import *from gmpy2 import *N =  =  =  = continued_fraction(e/N^4)convs = cf.convergents()for conv in convs:    d = conv.denominator()    if d.bit_length() == 1021:        print(f&#x27;d = &#123;d&#125;&#x27;)        m = pow(c,-d,N)        print(long_to_bytes(m))
